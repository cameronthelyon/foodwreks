# Copy to .env and fill in whichever keys you have. Every source is optional.
# OpenStreetMap is always on (free, no key) but carries no ratings.

# Google Places API (New): https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Yelp Fusion / Yelp Places API: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# Tripadvisor Content API: https://www.tripadvisor.com/developers
TRIPADVISOR_API_KEY=

PORT=3000

# Set to 1 to serve generated sample data instead of calling any API.
FOODWREKS_DEMO=0
