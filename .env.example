# Copy to .env and fill in. Real environment variables override this file.

# --- Core -------------------------------------------------------------------
# NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000
# Required in production. Generate: openssl rand -base64 48
# Keep it safe: it encrypts integration credentials and signs manage links.
APP_SECRET=
DATABASE_PATH=data/freehold.db
# Set to 1 behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=0
BRAND_NAME=Freehold
SUPPORT_EMAIL=help@example.org
# Public repository of the exact code this server runs (required by the AGPL).
SOURCE_URL=https://github.com/cameronthelyon/foodwreks
# 0 closes public sign-up (invite-only pilots).
SIGNUPS_OPEN=1
# Load the demo restaurant on start.
FREEHOLD_DEMO=0

# --- License ------------------------------------------------------------------
TRIAL_DAYS=30
LICENSE_PRICE_CENTS=100000
# Platform Stripe account for license payments (webhook: /webhooks/stripe).
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=

# --- Email: console | postmark | resend | none ----------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=Freehold <reservations@example.org>
POSTMARK_TOKEN=
RESEND_API_KEY=

# --- Text messages: none | console | twilio -------------------------------------
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- POS (read-only) -------------------------------------------------------------
# Square app: redirect URL {BASE_URL}/oauth/square/callback, webhook /webhooks/square
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Clover app: redirect URL {BASE_URL}/oauth/clover/callback, webhook /webhooks/clover
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_ENV=sandbox
CLOVER_REGION=us
CLOVER_WEBHOOK_AUTH_CODE=
# Toast credentials are entered per restaurant in the app.
TOAST_ENV=sandbox

# --- Google Actions Center (needs partner approval) -------------------------------
GOOGLE_BOOKING_USER=
GOOGLE_BOOKING_PASSWORD=
GOOGLE_PARTNER_ID=
# Path to, or inline JSON of, a service account with the mapsbooking scope.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Backups ----------------------------------------------------------------------
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
